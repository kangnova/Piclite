# Salin file ini menjadi `.env` lalu isi nilai yang tersedia.
# Semua bersifat opsional — biarkan kosong jika belum punya akunnya.
# Analytics otomatis nonaktif (no-op) selama nilainya kosong.

# Cloudflare Web Analytics (gratis): dashboard → Web Analytics → copy token JS
VITE_CF_BEACON_TOKEN=

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
VITE_GA_ID=

# ---- Backend statistik & AdSense (serverless di folder api/) ----
# Neon Postgres: console.neon.tech → project → Connection string
DATABASE_URL=

# Password halaman admin (#admin) — WAJIB kuat sebelum produksi
ADMIN_PASSWORD=

# Secret HMAC tanda tangan sesi admin (string acak panjang, beda dari password)
ADMIN_SECRET=
